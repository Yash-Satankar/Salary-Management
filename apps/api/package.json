{
  "name": "@acme/api",
  "version": "1.0.0",
  "private": true,
  "description": "ACME salary management REST API (Express 5 + Kysely + PostgreSQL)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.example --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/migrate.js && node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.example --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.example --env-file-if-exists=.env src/db/seed/run.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "explain": "tsx --env-file-if-exists=.env.example --env-file-if-exists=.env scripts/explain.ts"
  },
  "dependencies": {
    "@acme/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.4",
    "supertest": "^7.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  }
}
