# Local development defaults. `pnpm dev`, `db:migrate` and `db:seed` load this file first and then
# apps/api/.env (if present) on top, so copy it to .env only when you need to override something.
# Production never reads these files: set real values in the host's environment.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://acme:acme@localhost:5434/acme_salary
HR_EMAIL=hr@acme.test
# bcrypt (cost 12) hash of the local demo password "acme-demo-2026".
# Generate a new one with: pnpm --filter api hash-password '<password>'
HR_PASSWORD_HASH=$2b$12$PJT9JiqB.fivwTLLv9S0gOEmSNVQwvuBjWxC/xLIyW9mrZpJg1ee2
SESSION_SECRET=local-development-only-secret-change-me-0123456789
ALLOWED_ORIGINS=http://localhost:3000
